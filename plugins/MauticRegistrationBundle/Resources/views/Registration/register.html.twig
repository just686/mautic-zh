<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>注册 / Sign Up · 海客 HaiKe</title>
  <link rel="icon" href="{{ getOverridableUrl('images/favicon.ico') }}">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:#f5f7fb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;}
    .card{background:#fff;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,.08);padding:40px 36px;width:100%;max-width:420px;}
    .logo{text-align:center;margin-bottom:28px;}
    .logo svg{width:52px;height:52px;}
    .logo .brand{font-size:22px;font-weight:700;color:#0a1628;margin-top:8px;letter-spacing:1px;}
    .logo .sub{font-size:11px;color:#8899aa;letter-spacing:3px;margin-top:2px;}
    h1{font-size:18px;font-weight:600;color:#1a2332;text-align:center;margin-bottom:24px;}
    .field{margin-bottom:18px;}
    label{display:block;font-size:13px;color:#445566;margin-bottom:6px;font-weight:500;}
    input{width:100%;padding:10px 14px;border:1.5px solid #dde2ee;border-radius:8px;font-size:14px;color:#1a2332;outline:none;transition:border .2s;}
    input:focus{border-color:#4a6cf7;}
    .hint{font-size:11px;color:#8899aa;margin-top:4px;}
    .errors{background:#fff2f2;border:1px solid #ffcccc;border-radius:8px;padding:12px 16px;margin-bottom:18px;}
    .errors ul{list-style:none;padding:0;}
    .errors li{font-size:13px;color:#cc3333;padding:2px 0;}
    .errors li::before{content:"⚠ ";}
    .success{background:#f0fff4;border:1px solid #b2f0c8;border-radius:8px;padding:12px 16px;margin-bottom:18px;font-size:13px;color:#1a7a3c;}
    .btn{width:100%;padding:12px;background:#4a6cf7;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer;transition:background .2s;letter-spacing:.5px;}
    .btn:hover{background:#3457d5;}
    .footer-link{text-align:center;margin-top:20px;font-size:13px;color:#667788;}
    .footer-link a{color:#4a6cf7;font-weight:500;text-decoration:none;}
    .copyright{margin-top:32px;text-align:center;font-size:12px;color:#aabbcc;}
    .strength{height:3px;border-radius:2px;margin-top:6px;background:#eee;overflow:hidden;}
    .strength-bar{height:100%;width:0;transition:width .3s,background .3s;border-radius:2px;}
  </style>
</head>
<body>

<div class="card">
  <div class="logo">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" fill="none">
      <circle cx="20" cy="20" r="20" fill="#0a1628"/>
      <rect x="8" y="13" width="24" height="16" rx="3" stroke="white" stroke-width="2"/>
      <path d="M8 17 L20 24 L32 17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10 32 Q20 28 30 32" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <div class="brand">海客</div>
    <div class="sub">HaiKe</div>
  </div>

  <h1>创建账号 / Sign Up</h1>

  {% if errors is defined and errors|length > 0 %}
  <div class="errors">
    <ul>
      {% for error in errors %}
        <li>{{ error }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <form method="POST" action="/register" novalidate>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('registration') }}">

    <div class="field">
      <label for="email">邮箱 / Email</label>
      <input type="email" id="email" name="email"
             value="{{ email|default('') }}"
             placeholder="your@email.com" autocomplete="email" required>
    </div>

    <div class="field">
      <label for="password">密码 / Password</label>
      <div style="position:relative;display:flex;align-items:center;">
        <input type="password" id="password" name="password"
               style="flex:1;padding-right:40px;"
               placeholder="请输入密码" autocomplete="new-password" required>
        <button type="button" id="toggle-password"
                style="position:absolute;right:10px;background:none;border:none;
                       cursor:pointer;color:#666;font-size:16px;"
                title="显示/隐藏密码">👁</button>
      </div>
      <div class="strength"><div class="strength-bar" id="strength-bar"></div></div>
      <div class="hint" id="strength-hint">建议使用大小写字母、数字和符号混合 / Mix of letters, numbers and symbols</div>
    </div>

    <div class="field">
      <label for="confirm_password">确认密码 / Confirm Password</label>
      <div style="position:relative;display:flex;align-items:center;">
        <input type="password" id="confirm_password" name="confirm_password"
               style="flex:1;padding-right:40px;"
               placeholder="请再次输入密码" autocomplete="new-password" required>
        <button type="button" id="toggle-confirm"
                style="position:absolute;right:10px;background:none;border:none;
                       cursor:pointer;color:#666;font-size:16px;"
                title="显示/隐藏密码">👁</button>
      </div>
    </div>

    <div style="margin-top:8px;display:flex;gap:8px;align-items:center;">
      <button type="button" id="btn-generate"
              style="padding:6px 14px;background:#4a90d9;color:#fff;
                     border:none;border-radius:4px;cursor:pointer;font-size:13px;">
        🔑 生成安全密码
      </button>
      <button type="button" id="btn-copy"
              style="padding:6px 14px;background:#6c757d;color:#fff;
                     border:none;border-radius:4px;cursor:pointer;font-size:13px;
                     display:none;">
        📋 复制密码
      </button>
      <span id="copy-tip"
            style="font-size:12px;color:#28a745;display:none;">
        ✓ 已复制
      </span>
    </div>

    <button type="submit" class="btn">注册 / Sign Up</button>
  </form>

  <div class="footer-link">
    已有账号？<a href="/s/login">去登录 / Sign In</a>
  </div>
</div>

<div class="copyright">© {{ "now"|date("Y") }} 海客 HaiKe. All Rights Reserved.</div>

<script>
var pwd = document.getElementById('password');
var bar = document.getElementById('strength-bar');
var hint = document.getElementById('strength-hint');
if(pwd){
  pwd.addEventListener('input', function(){
    var v = this.value;
    var score = 0;
    if(v.length >= 8) score++;
    if(/[a-zA-Z]/.test(v)) score++;
    if(/[0-9]/.test(v)) score++;
    if(/[^a-zA-Z0-9]/.test(v)) score++;
    var pct = ['0%','33%','60%','85%','100%'][score];
    var color = ['#eee','#ff4444','#ffaa00','#44bb44','#00aa44'][score];
    var text = ['','弱 Weak','一般 Fair','强 Strong','非常强 Very Strong'][score];
    bar.style.width = pct;
    bar.style.background = color;
    hint.textContent = text || '建议使用大小写字母、数字和符号混合 / Mix of letters, numbers and symbols';
  });
}

// ── 生成随机安全密码 ──
function generatePassword() {
    var upper  = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
    var lower  = 'abcdefghjkmnpqrstuvwxyz';
    var digits = '23456789';
    var special = '!@#$%^&*';
    var all = upper + lower + digits + special;
    var pwd = [
        upper [Math.floor(Math.random() * upper.length)],
        lower [Math.floor(Math.random() * lower.length)],
        digits[Math.floor(Math.random() * digits.length)],
        special[Math.floor(Math.random() * special.length)]
    ];
    for (var i = 4; i < 12; i++) {
        pwd.push(all[Math.floor(Math.random() * all.length)]);
    }
    // Fisher-Yates 洗牌
    for (var i = pwd.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = pwd[i]; pwd[i] = pwd[j]; pwd[j] = tmp;
    }
    return pwd.join('');
}

// ── 生成按钮点击 ──
var btnGenerate = document.getElementById('btn-generate');
var btnCopy     = document.getElementById('btn-copy');
var copyTip     = document.getElementById('copy-tip');
var _generatedPwd = '';

if (btnGenerate) {
    btnGenerate.addEventListener('click', function() {
        _generatedPwd = generatePassword();
        var pwdInput     = document.getElementById('password');
        var confirmInput = document.getElementById('confirm_password');
        // 同时填充两个字段
        pwdInput.value     = _generatedPwd;
        confirmInput.value = _generatedPwd;
        // 切换为明文显示，让用户看到密码
        pwdInput.type     = 'text';
        confirmInput.type = 'text';
        // 触发强度检测
        pwdInput.dispatchEvent(new Event('input'));
        // 显示复制按钮
        btnCopy.style.display = 'inline-block';
        copyTip.style.display = 'none';
    });
}

// ── 复制按钮 ──
if (btnCopy) {
    btnCopy.addEventListener('click', function() {
        if (!_generatedPwd) return;
        navigator.clipboard.writeText(_generatedPwd).then(function() {
            copyTip.style.display = 'inline';
            setTimeout(function(){ copyTip.style.display = 'none'; }, 2000);
        }).catch(function() {
            // 降级方案
            var ta = document.createElement('textarea');
            ta.value = _generatedPwd;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            copyTip.style.display = 'inline';
            setTimeout(function(){ copyTip.style.display = 'none'; }, 2000);
        });
    });
}

// ── 显示/隐藏密码切换 ──
function bindToggle(btnId, inputId) {
    var btn   = document.getElementById(btnId);
    var input = document.getElementById(inputId);
    if (btn && input) {
        btn.addEventListener('click', function() {
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁';
            }
        });
    }
}
bindToggle('toggle-password', 'password');
bindToggle('toggle-confirm',  'confirm_password');
</script>

</body>
</html>
